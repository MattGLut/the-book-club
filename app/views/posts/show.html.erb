<% content_for :title, @post.title %>

<article>
  <header class="mb-6">
    <h2 class="text-2xl font-semibold tracking-tight"><%= @post.title %></h2>
    <p class="mt-2 text-sm text-stone-500">
      <%= @post.user.email %> · <%= @post.created_at.strftime("%B %-d, %Y") %>
    </p>
  </header>

  <div class="prose prose-stone max-w-none prose-headings:font-semibold prose-a:text-accent">
    <%= render_markdown(@post.body) %>
  </div>

  <% if user_signed_in? %>
    <footer class="mt-8 flex items-center gap-4 border-t border-stone-200 pt-4 text-sm">
      <%= link_to "Edit", edit_post_path(@post), class: "text-accent no-underline hover:underline" %>
      <%= button_to "Delete", @post, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer border-0 bg-transparent p-0 text-sm text-red-700 underline hover:text-red-900" %>
    </footer>
  <% end %>
</article>

<p class="mt-8">
  <%= link_to "← Back to posts", posts_path, class: "text-sm text-accent no-underline hover:underline" %>
</p>
