<h2 class="mb-6 text-2xl font-semibold tracking-tight">Forgot your password?</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-base shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" %>
  </div>

  <div>
    <%= f.submit "Send reset instructions", class: "cursor-pointer rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent-hover" %>
  </div>
<% end %>

<div class="mt-6 text-sm">
  <%= render "devise/shared/links" %>
</div>
